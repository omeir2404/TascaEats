    {
      "name": "4.1 - Validacao (Enunciado)",
      "item": [
        {
          "name": "4.1A - Regras de Negocio (Video)",
          "item": [
            {
              "name": "R1 - INVALID - Cancelar pedido em preparo",
              "request": {
                "method": "PATCH",
                "description": "Pre-condicao: colocar pedido em A_PREPARAR com /entregas/pedido/{pedidoId}/iniciar-preparacao. Resultado esperado: erro de regra de negocio (409).",
                "url": "{{baseUrl}}/pedidos/{{pedidoId}}/cancelar"
              }
            },
            {
              "name": "R2 - VALID+INVALID - Soft delete de produto",
              "request": {
                "method": "DELETE",
                "description": "Passo 1: apagar produto (soft delete). Passo 2: tentar alterar disponibilidade do mesmo produto e validar erro de regra de negocio.",
                "url": "{{baseUrl}}/api/produtos/{{produtoId}}"
              }
            },
            {
              "name": "R2b - INVALID - Alterar disponibilidade apos soft delete",
              "request": {
                "method": "PATCH",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"disponivel\": true\n}"
                },
                "url": "{{baseUrl}}/api/produtos/{{produtoId}}/disponibilidade"
              }
            },
            {
              "name": "R3 - INVALID - Criar pedido em restaurante fechado",
              "request": {
                "method": "POST",
                "description": "Pre-condicao: fechar restaurante com /api/restaurantes/{restauranteId}/fechar. Resultado esperado: erro de regra de negocio (409).",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"clienteId\": {{clienteId}},\n  \"restauranteId\": {{restauranteId}},\n  \"produtosIds\": [{{produtoId}}]\n}"
                },
                "url": "{{baseUrl}}/pedidos"
              }
            },
            {
              "name": "R4 - INVALID - Criar pedido com produto esgotado",
              "request": {
                "method": "POST",
                "description": "Pre-condicao: colocar produto indisponivel com PATCH /api/produtos/{produtoId}/disponibilidade {disponivel:false}. Resultado esperado: erro de regra de negocio (409).",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"clienteId\": {{clienteId}},\n  \"restauranteId\": {{restauranteId}},\n  \"produtosIds\": [{{produtoId}}]\n}"
                },
                "url": "{{baseUrl}}/pedidos"
              }
            },
            {
              "name": "R5 - INVALID - Associar entrega sem entregadores disponiveis",
              "request": {
                "method": "POST",
                "description": "Pre-condicao: todos os entregadores com available=false e pedido em PRONTO_PARA_ENTREGA. Resultado esperado: erro de regra de negocio (409).",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"pedidoId\": {{pedidoId}}\n}"
                },
                "url": "{{baseUrl}}/entregas/atribuir"
              }
            }
          ]
        },
        {
          "name": "4.1B - Perguntas de Negocio (Checklist)",
          "item": [
            {
              "name": "Q1 - Restaurantes com maior volume de vendas",
              "request": {
                "method": "GET",
                "description": "Checklist de validacao BD: executar query SQL para ranking de restaurantes por valor_total de pedidos pagos/entregues.",
                "url": "{{baseUrl}}/pedidos"
              }
            },
            {
              "name": "Q2 - Morada do restaurante e cliente com mais vendas/pedidos",
              "request": {
                "method": "GET",
                "description": "Checklist de validacao BD: cruzar tabelas de pedidos, restaurantes e utilizadores para obter top restaurante e top cliente.",
                "url": "{{baseUrl}}/api/restaurantes"
              }
            },
            {
              "name": "Q3 - Media de pedidos por cliente por mes",
              "request": {
                "method": "GET",
                "description": "Checklist de validacao BD: agrupar pedidos por cliente e mes e calcular media mensal.",
                "url": "{{baseUrl}}/pedidos"
              }
            },
            {
              "name": "Q4 - Produtos mais vendidos",
              "request": {
                "method": "GET",
                "description": "Checklist de validacao BD: usar relacao pedido_produtos/pedido_produto para contar vendas por produto.",
                "url": "{{baseUrl}}/api/produtos"
              }
            },
            {
              "name": "Q5 - Metodo de pagamento mais utilizado",
              "request": {
                "method": "GET",
                "description": "Checklist de validacao BD: agrupar pagamentos por tipo e ordenar por frequencia.",
                "url": "{{baseUrl}}/pagamentos"
              }
            },
            {
              "name": "Q6 - Clientes registados sem compras",
              "request": {
                "method": "GET",
                "description": "Checklist de validacao BD: listar clientes sem registos na tabela de pedidos (LEFT JOIN + IS NULL).",
                "url": "{{baseUrl}}/api/Utilizadors"
              }
            }
          ]
        }
      ]
    }
