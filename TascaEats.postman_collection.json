  "item": [
    {
      "name": "Auth & Users",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"secret\"\n}"
            },
            "url": "{{baseUrl}}/api/login"
          }
        },
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ana\",\n  \"email\": \"ana@example.com\",\n  \"password\": \"secret\",\n  \"type\": \"client\",\n  \"address\": {\n    \"rua\": \"Rua A\",\n    \"numero\": 10,\n    \"complemento\": \"1o Dto\",\n    \"codigoPostal\": \"1000-100\",\n    \"cidade\": \"Lisboa\",\n    \"distrito\": \"Lisboa\",\n    \"pais\": \"Portugal\"\n  }\n}"
            },
            "url": "{{baseUrl}}/api/register"
          }
        },
        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/Utilizadors"
          }
        },
        {
          "name": "Get User By Id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/Utilizadors/{{userId}}"
          }
        },
        {
          "name": "Update User",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ana Updated\",\n  \"email\": \"ana.updated@example.com\",\n  \"password\": \"newsecret\",\n  \"type\": \"client\"\n}"
            },
            "url": "{{baseUrl}}/api/Utilizadors/{{userId}}"
          }
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/Utilizadors/{{userId}}"
          }
        }
      ]
    },
    {
      "name": "Restaurants",
      "item": [
        {
          "name": "Create Restaurant",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Tasca Eats\",\n  \"nif\": \"123456789\",\n  \"morada\": {\n    \"rua\": \"Rua da Tasca\",\n    \"numero\": 10,\n    \"complemento\": \"1o Dto\",\n    \"codigoPostal\": \"1000-100\",\n    \"cidade\": \"Lisboa\",\n    \"distrito\": \"Lisboa\",\n    \"pais\": \"Portugal\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/restaurantes?adminEmail=admin@tasca.pt",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "restaurantes"
              ],
              "query": [
                {
                  "key": "adminEmail",
                  "value": "admin@tasca.pt"
                }
              ]
            }
          }
        },
        {
          "name": "Update Restaurant",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Tasca Eats Updated\",\n  \"nif\": \"123456789\",\n  \"morada\": {\n    \"rua\": \"Rua Nova\",\n    \"numero\": 11,\n    \"complemento\": \"Loja\",\n    \"codigoPostal\": \"1000-101\",\n    \"cidade\": \"Lisboa\",\n    \"distrito\": \"Lisboa\",\n    \"pais\": \"Portugal\"\n  }\n}"
            },
            "url": "{{baseUrl}}/api/restaurantes/{{restauranteId}}"
          }
        },
        {
          "name": "Update Restaurant State",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"ABERTO\"\n}"
            },
            "url": "{{baseUrl}}/api/restaurantes/{{restauranteId}}/estado"
          }
        },
        {
          "name": "Open Restaurant",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/restaurantes/{{restauranteId}}/abrir"
          }
        },
        {
          "name": "Close Restaurant",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/restaurantes/{{restauranteId}}/fechar"
          }
        },
        {
          "name": "Get Restaurant By Id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/restaurantes/{{restauranteId}}"
          }
        },
        {
          "name": "List Restaurants",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/restaurantes"
          }
        },
        {
          "name": "Search Restaurants By Name",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/restaurantes?nome=tasca",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "restaurantes"
              ],
              "query": [
                {
                  "key": "nome",
                  "value": "tasca"
                }
              ]
            }
          }
        },
        {
          "name": "Search Restaurants By City",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/restaurantes?cidade=lisboa",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "restaurantes"
              ],
              "query": [
                {
                  "key": "cidade",
                  "value": "lisboa"
                }
              ]
            }
          }
        },
        {
          "name": "Filter Restaurants By State",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/restaurantes?estado=ABERTO",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "restaurantes"
              ],
              "query": [
                {
                  "key": "estado",
                  "value": "ABERTO"
                }
              ]
            }
          }
        }
